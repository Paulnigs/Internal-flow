# PostgreSQL (required). Local Docker: npm run db:up then use URL below.
DATABASE_URL="postgresql://studio:studio@localhost:5432/studio_pro?schema=public"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string-min-16-chars"
